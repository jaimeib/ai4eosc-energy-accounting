# Run every 6 hours, 5 minutes past each mark (00:05, 06:05, 12:05, 18:05
# UTC): the delay gives Mimir time to finish scraping the 00:00/06:00/
# 12:00/18:00 boundary before this run queries up to it -- see
# pointer.align_seconds / pointer.query_lag_seconds in config.example.yaml.
# Install with: crontab -e
#
# Everything the script needs/produces (config.yaml, the pointer file,
# sender output, logs) lives inside the project directory - only the
# path below needs to point at wherever you cloned it.
5 0,6,12,18 * * * cd /path/to/ai4eosc-energy-accounting && .venv/bin/python -m ai4eosc_energy_accounting.main >> var/cron.log 2>&1
